{
  "manifest_version": 3,
  "name": "Overleaf · Codex 建议包逐项审阅",
  "version": "1.1.1",
  "description": "导入 Codex 生成的 JSON 建议包，在当前 Overleaf 源码中定位、逐项确认；过时或不唯一的项跳过。",
  "content_scripts": [
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "main.bundle.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.overleaf.com/project/*",
        "https://overleaf.com/project/*"
      ],
      "js": [
        "content.bundle.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:43127/*"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  }
}
